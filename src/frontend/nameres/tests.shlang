//global_fns
var b = a();
func a() {
	return 10;
}

//with_scopes
func main(){
	var a = 10;
	do {
		var a = a;
	}
}

//class_literal
class foo {var x; var b = 10;}

//class_method
class foo {
	func abc(a,b,c) {
		return 10;
	}
	static func hello(foo) {
		return foo;
	}
	let x = 20;
}

//class_literal_with_static_properties
class foo { static a = 10; static var b = 20; }

//anonymous_global_class_self_type
class {
	static value = 10;
	static func get() {
		return Self.value;
	}
}

//anonymous_local_class_self_type
func make() {
	class {
		static value = 10;
		static func get() {
			return Self.value;
		}
	}
}

//named_class_self_type
class example {
	static value = 10;
	static func get() {
		return Self.value;
	}
}
