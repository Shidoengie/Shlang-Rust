//Variable overloading
var a = 1;
var a = 1;
var a = 1;
var b = a;
//Variable usage
var a = 1;
var b = a;
//Undefined variable usage
var a = c;
//Scopes
var a = 10;
do {
	var a = a;
}
//Variable used outside scope
do {
	var a = 10;
};
var b = a;
//Loops
for i in [1,2,3] {
	var b = i
}
//Loop var out of scope
for i in [1,2,3] {
	var b = i
};
var d = i;
//Functions
var b = 10;
func a(c) {
	var d = b;
}
//ids
var a = 10;
do {
	var b = 20;
	var c = 30;
	var d = 123;
}
var c = 10;
do {
	var b = 20;
	var c = 30;
	var d = 123;
}
