func main(){
    var i = 0;
    while i < 100 {
        i += 1;
        var buffer = "";
        if i % 3 == 0 {
            buffer += "Fizz";
        }
        if i % 5 == 0{
            buffer += "Buzz";
        }
        if buffer == "" {
            print(i);
        } else {
            print(buffer);
        };
    }
    return;
}
